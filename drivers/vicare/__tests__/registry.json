{
  "_comment": [
    "Every user-facing identifier this app ships. registry.test.js fails if config.js (capabilities)",
    "or driver.flow.compose.json (flow cards) no longer provides one of them: renaming or removing a",
    "capability deletes the user's Insights history and breaks Flows, and changing a flow card id,",
    "argument, dropdown value or token breaks saved Flows. Device settings (driver.compose.json) are",
    "guarded the same way: renaming one, changing its type or removing a dropdown value resets the value",
    "users have set.",
    "New identifiers: add them here in the same change. Deliberately retiring a capability: move it",
    "from 'capabilities' to 'retiredCapabilities' with a note on why and what replaced it."
  ],
  "capabilities": [
    "measure_burner_active",
    "measure_burner_number.burnerHours",
    "measure_burner_number.burnerModulation",
    "measure_burner_number.burnerStarts",
    "measure_compressor_active",
    "measure_compressor_number.compressorHours",
    "measure_compressor_number.compressorModulation",
    "measure_compressor_number.compressorStarts",
    "measure_cop_number.dhw",
    "measure_cop_number.heating",
    "measure_cop_number.total",
    "measure_fuelcell_number.operationHours",
    "measure_fuelcell_number.productionHours",
    "measure_fuelcell_number.productionStarts",
    "measure_fuelcell_phase",
    "measure_temperature.boilerCommonSupply",
    "measure_temperature.boiler_main",
    "measure_temperature.buffer",
    "measure_temperature.circuit0",
    "measure_temperature.circuit0_room",
    "measure_temperature.circuit0_supply",
    "measure_temperature.fuelCellReturn",
    "measure_temperature.fuelCellSupply",
    "measure_temperature.hotWater",
    "measure_temperature.outside",
    "measure_temperature.primaryReturn",
    "measure_temperature.return",
    "measure_temperature.secondarySupply",
    "measure_temperature.supply",
    "target_temperature.heating",
    "target_temperature.hotWater",
    "target_temperature.hotWater2",
    "thermostat_mode.fuelCell",
    "thermostat_mode.heating",
    "thermostat_mode.hotWaterOneTimeCharge",
    "target_temperature",
    "measure_temperature",
    "thermostat_mode",
    "thermostat_mode.heatingProgram",
    "target_temperature.heatingReduced",
    "target_temperature.heatingComfort",
    "measure_holiday_active",
    "thermostat_mode.hotWater",
    "target_hysteresis.hotWater",
    "measure_heating_active",
    "measure_operating_state",
    "measure_status_text"
  ],
  "retiredCapabilities": {
    "measure_something_active.compressor": "Renamed to measure_compressor_active in commit d9a0906 (v1.0.11). Users lost their compressor Insights history at the time.",
    "measure_something_number.compressorHours": "Renamed to measure_compressor_number.compressorHours in commit d9a0906 (v1.0.11).",
    "measure_something_number.compressorStarts": "Renamed to measure_compressor_number.compressorStarts in commit d9a0906 (v1.0.11)."
  },
  "flowCards": {
    "conditions": {
      "compressor-is-running": {
        "args": {}
      },
      "burner-is-running": {
        "args": {}
      },
      "heating-is-active": {
        "args": {}
      },
      "operating-state-is": {
        "args": {
          "state": {
            "type": "dropdown",
            "values": ["heating", "hotWater", "defrost", "cooling", "standby"]
          }
        }
      },
      "heating-program-is": {
        "args": {
          "program": {
            "type": "dropdown",
            "values": ["normal", "reduced", "comfort", "eco"]
          }
        }
      },
      "holiday-is-active": {
        "args": {}
      }
    },
    "actions": {
      "set-operating-mode": {
        "args": {
          "mode": {
            "type": "dropdown",
            "values": ["dhw", "heating", "dhwAndHeating", "forcedNormal", "forcedReduced", "standby"]
          }
        }
      },
      "set-heating-thermostat": {
        "args": {
          "temperature": {
            "type": "number"
          }
        }
      },
      "set-hot-water-thermostat": {
        "args": {
          "temperature": {
            "type": "number"
          }
        }
      },
      "do-one-time-hot-water-charge": {
        "args": {
          "active": {
            "type": "dropdown",
            "values": ["activate", "deactivate"]
          }
        }
      },
      "set-hot-water-thermostat2": {
        "args": {
          "temperature": {
            "type": "number"
          }
        }
      },
      "set-fuelcell-mode": {
        "args": {
          "mode": {
            "type": "dropdown",
            "values": ["standby", "maintenance", "heatControlled", "economical", "ecological"]
          }
        }
      },
      "set-device-operating-mode": {
        "args": {
          "mode": {
            "type": "autocomplete"
          }
        }
      },
      "set-heating-program": {
        "args": {
          "program": {
            "type": "dropdown",
            "values": ["normal", "reduced", "comfort", "eco"]
          }
        }
      },
      "set-heating-reduced-thermostat": {
        "args": {
          "temperature": {
            "type": "number"
          }
        }
      },
      "set-heating-comfort-thermostat": {
        "args": {
          "temperature": {
            "type": "number"
          }
        }
      },
      "start-holiday": {
        "args": {
          "start": {
            "type": "date"
          },
          "end": {
            "type": "date"
          }
        }
      },
      "end-holiday": {
        "args": {}
      },
      "set-hot-water-mode": {
        "args": {
          "mode": {
            "type": "autocomplete"
          }
        }
      },
      "set-hot-water-hysteresis": {
        "args": {
          "hysteresis": {
            "type": "number"
          }
        }
      }
    },
    "triggers": {
      "heating-mode-changed": {
        "args": {},
        "tokens": {
          "mode": "string"
        }
      },
      "heating-started": {
        "args": {}
      },
      "heating-stopped": {
        "args": {}
      },
      "operating-state-changed": {
        "args": {},
        "tokens": {
          "state": "string"
        }
      },
      "heating-program-changed": {
        "args": {},
        "tokens": {
          "program": "string"
        }
      }
    }
  },
  "deviceSettings": {
    "heatingCircuit": {
      "type": "dropdown",
      "values": ["auto", "0", "1", "2", "3"]
    }
  }
}
