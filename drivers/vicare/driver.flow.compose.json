{
  "conditions": [
    {
      "id": "compressor-is-running",
      "title": {
        "en": "Compressor is !{{running|not running}}"
      },
      "titleFormatted": {
        "en": "Compressor is !{{running|not running}}"
      },
      "$filter": "capabilities=measure_compressor_active",
      "args": [],
      "hint": {
        "en": "Checking last known state, i.e. could return incorrect value if not recently synced."
      }
    },
    {
      "id": "burner-is-running",
      "title": {
        "en": "Burner is !{{running|not running}}"
      },
      "titleFormatted": {
        "en": "Burner is !{{running|not running}}"
      },
      "$filter": "capabilities=measure_burner_active",
      "args": [],
      "hint": {
        "en": "Checking last known state, i.e. could return incorrect value if not recently synced."
      }
    }
  ],
  "actions": [
    {
      "id": "set-operating-mode",
      "title": {
        "en": "Set operating mode to [[mode]]"
      },
      "titleFormatted": {
        "en": "Set operating mode to [[mode]]"
      },
      "$filter": "capabilities=thermostat_mode.heating",
      "args": [
        {
          "name": "mode",
          "type": "dropdown",
          "values": [
            {
              "id": "dhw",
              "title": {
                "en": "Hot water only"
              }
            },
            {
              "id": "heating",
              "title": {
                "en": "Heating only"
              }
            },
            {
              "id": "dhwAndHeating",
              "title": {
                "en": "Hot water and heating"
              }
            },
            {
              "id": "forcedNormal",
              "title": {
                "en": "Forced normal"
              }
            },
            {
              "id": "forcedReduced",
              "title": {
                "en": "Forced reduced"
              }
            },
            {
              "id": "standby",
              "title": {
                "en": "Standby"
              }
            }
          ]
        }
      ],
      "hint": {
        "en": "Note: Not all operating modes are supported by all installations"
      }
    },
    {
      "id": "set-heating-thermostat",
      "title": {
        "en": "Set heating target temperature to [[temperature]] °C"
      },
      "titleFormatted": {
        "en": "Set heating target temperature to [[temperature]] °C"
      },
      "$filter": "capabilities=target_temperature.heating",
      "args": [
        {
          "name": "temperature",
          "type": "number",
          "min": 3,
          "max": 37,
          "step": 1,
          "title": {
            "en": "Temperature"
          }
        }
      ]
    },
    {
      "id": "set-hot-water-thermostat",
      "title": {
        "en": "Set hot water Normal target temperature to [[temperature]] °C"
      },
      "titleFormatted": {
        "en": "Set hot water Normal target temperature to [[temperature]] °C"
      },
      "$filter": "capabilities=target_temperature.hotWater",
      "args": [
        {
          "name": "temperature",
          "type": "number",
          "min": 10,
          "max": 60,
          "step": 1,
          "title": {
            "en": "Temperature"
          }
        }
      ]
    },
    {
      "id": "do-one-time-hot-water-charge",
      "title": {
        "en": "Set one time hot water charge"
      },
      "titleFormatted": {
        "en": "Set one time hot water charge to [[active]]"
      },
      "$filter": "capabilities=thermostat_mode.hotWaterOneTimeCharge",
      "args": [
        {
          "name": "active",
          "type": "dropdown",
          "values": [
            {
              "id": "activate",
              "title": {
                "en": "Active"
              }
            },
            {
              "id": "deactivate",
              "title": {
                "en": "Inactive"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "set-hot-water-thermostat2",
      "title": {
        "en": "Set hot water Temp 2 target temperature to [[temperature]] °C"
      },
      "titleFormatted": {
        "en": "Set hot water Temp 2 target temperature to [[temperature]] °C"
      },
      "$filter": "capabilities=target_temperature.hotWater2",
      "args": [
        {
          "name": "temperature",
          "type": "number",
          "min": 10,
          "max": 60,
          "step": 1,
          "title": {
            "en": "Temperature"
          }
        }
      ]
    },
    {
      "id": "set-fuelcell-mode",
      "title": {
        "en": "Set fuel cell mode to [[mode]]"
      },
      "titleFormatted": {
        "en": "Set fuel cell mode to [[mode]]"
      },
      "$filter": "capabilities=thermostat_mode.fuelCell",
      "args": [
        {
          "name": "mode",
          "type": "dropdown",
          "values": [
            {
              "id": "standby",
              "title": {
                "en": "Standby"
              }
            },
            {
              "id": "maintenance",
              "title": {
                "en": "Maintenance"
              }
            },
            {
              "id": "heatControlled",
              "title": {
                "en": "Heat controlled"
              }
            },
            {
              "id": "economical",
              "title": {
                "en": "Economical"
              }
            },
            {
              "id": "ecological",
              "title": {
                "en": "Ecological"
              }
            }
          ]
        }
      ]
    }
  ],
  "triggers": [
    {
      "id": "heating-mode-changed",
      "title": {
        "en": "Operating mode changed"
      },
      "$filter": "capabilities=thermostat_mode.heating",
      "args": [],
      "tokens": [
        {
          "name": "mode",
          "type": "string",
          "title": {
            "en": "Mode"
          },
          "example": {
            "en": "dhw"
          }
        }
      ]
    },
    {
      "id": "fault-reported",
      "title": {
        "en": "The heating system reported a fault",
        "de": "Die Heizung hat eine Störung gemeldet",
        "nl": "De verwarming heeft een storing gemeld",
        "fr": "Le chauffage a signalé un défaut",
        "sv": "Värmesystemet rapporterade ett fel"
      },
      "hint": {
        "en": "Fires once for each new fault code the heating system reports, for example F.160. The manual of your heating system explains the code.",
        "de": "Wird einmal für jeden neuen Störungscode ausgelöst, den die Heizung meldet, zum Beispiel F.160. Die Anleitung deiner Heizung erklärt den Code.",
        "nl": "Wordt één keer geactiveerd voor elke nieuwe storingscode die de verwarming meldt, bijvoorbeeld F.160. De handleiding van je verwarming legt de code uit.",
        "fr": "Se déclenche une fois pour chaque nouveau code de défaut signalé par le chauffage, par exemple F.160. La notice de votre chauffage explique le code.",
        "sv": "Körs en gång för varje ny felkod som värmesystemet rapporterar, till exempel F.160. Värmesystemets manual förklarar koden."
      },
      "$filter": "capabilities=alarm_problem",
      "args": [],
      "tokens": [
        {
          "name": "code",
          "type": "string",
          "title": {
            "en": "Fault code",
            "de": "Störungscode",
            "nl": "Storingscode",
            "fr": "Code de défaut",
            "sv": "Felkod"
          },
          "example": {
            "en": "F.160"
          }
        },
        {
          "name": "priority",
          "type": "string",
          "title": {
            "en": "Priority",
            "de": "Priorität",
            "nl": "Prioriteit",
            "fr": "Priorité",
            "sv": "Prioritet"
          },
          "example": {
            "en": "error"
          }
        }
      ]
    },
    {
      "id": "logbook-entry-added",
      "title": {
        "en": "A logbook entry was added",
        "de": "Ein Logbucheintrag wurde hinzugefügt",
        "nl": "Er is een logboekregel toegevoegd",
        "fr": "Une entrée a été ajoutée au journal",
        "sv": "En loggbokspost lades till"
      },
      "hint": {
        "en": "Fires for each new entry in the logbook of the heating system, on systems that keep one.",
        "de": "Wird für jeden neuen Eintrag im Logbuch der Heizung ausgelöst, bei Anlagen, die eines führen.",
        "nl": "Wordt geactiveerd voor elke nieuwe regel in het logboek van de verwarming, bij installaties die er een bijhouden.",
        "fr": "Se déclenche pour chaque nouvelle entrée du journal du chauffage, sur les installations qui en tiennent un.",
        "sv": "Körs för varje ny post i värmesystemets loggbok, på anläggningar som för en."
      },
      "$filter": "capabilities=alarm_problem",
      "args": [],
      "tokens": [
        {
          "name": "event",
          "type": "string",
          "title": {
            "en": "Event",
            "de": "Ereignis",
            "nl": "Gebeurtenis",
            "fr": "Événement",
            "sv": "Händelse"
          },
          "example": {
            "en": "Inverter_Autotune_fault"
          }
        },
        {
          "name": "actor",
          "type": "string",
          "title": {
            "en": "Component",
            "de": "Komponente",
            "nl": "Onderdeel",
            "fr": "Composant",
            "sv": "Komponent"
          },
          "example": {
            "en": "KAELTEKR_UMKEHR"
          }
        },
        {
          "name": "status",
          "type": "number",
          "title": {
            "en": "Status",
            "de": "Status",
            "nl": "Status",
            "fr": "Statut",
            "sv": "Status"
          },
          "example": {
            "en": "1"
          }
        },
        {
          "name": "circuit",
          "type": "string",
          "title": {
            "en": "Circuit",
            "de": "Kreis",
            "nl": "Circuit",
            "fr": "Circuit",
            "sv": "Krets"
          },
          "example": {
            "en": "Heizkreis"
          }
        }
      ]
    },
    {
      "id": "event-logged",
      "title": {
        "en": "An event was logged",
        "de": "Ein Ereignis wurde protokolliert",
        "nl": "Er is een gebeurtenis gelogd",
        "fr": "Un événement a été enregistré",
        "sv": "En händelse loggades"
      },
      "hint": {
        "en": "Needs the event log, which is off by default: turn it on in the device's settings under Updates and API calls.",
        "de": "Braucht das Ereignisprotokoll, das standardmäßig aus ist: Schalte es in den Geräteeinstellungen unter Aktualisierung und API-Aufrufe ein.",
        "nl": "Heeft het gebeurtenissenlogboek nodig, dat standaard uit staat: zet het aan in de apparaatinstellingen onder Updates en API-aanroepen.",
        "fr": "Nécessite le journal des événements, désactivé par défaut : activez-le dans les réglages de l'appareil, sous Mises à jour et appels API.",
        "sv": "Kräver händelseloggen, som är av som standard: slå på den i enhetens inställningar under Uppdateringar och API-anrop."
      },
      "$filter": "capabilities=alarm_problem",
      "args": [],
      "tokens": [
        {
          "name": "code",
          "type": "string",
          "title": {
            "en": "Code",
            "de": "Code",
            "nl": "Code",
            "fr": "Code",
            "sv": "Kod"
          },
          "example": {
            "en": "F.160"
          }
        },
        {
          "name": "description",
          "type": "string",
          "title": {
            "en": "Description",
            "de": "Beschreibung",
            "nl": "Omschrijving",
            "fr": "Description",
            "sv": "Beskrivning"
          },
          "example": {
            "en": "Burner fault"
          }
        },
        {
          "name": "type",
          "type": "string",
          "title": {
            "en": "Type",
            "de": "Typ",
            "nl": "Type",
            "fr": "Type",
            "sv": "Typ"
          },
          "example": {
            "en": "device-error"
          }
        },
        {
          "name": "active",
          "type": "boolean",
          "title": {
            "en": "Active",
            "de": "Aktiv",
            "nl": "Actief",
            "fr": "Actif",
            "sv": "Aktiv"
          },
          "example": {
            "en": "true"
          }
        }
      ]
    },
    {
      "id": "event-code-logged",
      "title": {
        "en": "An event with a code was logged",
        "de": "Ein Ereignis mit einem Code wurde protokolliert",
        "nl": "Er is een gebeurtenis met een code gelogd",
        "fr": "Un événement avec un code a été enregistré",
        "sv": "En händelse med en kod loggades"
      },
      "titleFormatted": {
        "en": "Event [[code]] was logged",
        "de": "Ereignis [[code]] wurde protokolliert",
        "nl": "Gebeurtenis [[code]] is gelogd",
        "fr": "L'événement [[code]] a été enregistré",
        "sv": "Händelsen [[code]] loggades"
      },
      "hint": {
        "en": "Needs the event log, which is off by default: turn it on in the device's settings under Updates and API calls.",
        "de": "Braucht das Ereignisprotokoll, das standardmäßig aus ist: Schalte es in den Geräteeinstellungen unter Aktualisierung und API-Aufrufe ein.",
        "nl": "Heeft het gebeurtenissenlogboek nodig, dat standaard uit staat: zet het aan in de apparaatinstellingen onder Updates en API-aanroepen.",
        "fr": "Nécessite le journal des événements, désactivé par défaut : activez-le dans les réglages de l'appareil, sous Mises à jour et appels API.",
        "sv": "Kräver händelseloggen, som är av som standard: slå på den i enhetens inställningar under Uppdateringar och API-anrop."
      },
      "$filter": "capabilities=alarm_problem",
      "args": [
        {
          "name": "code",
          "type": "text",
          "title": {
            "en": "Code",
            "de": "Code",
            "nl": "Code",
            "fr": "Code",
            "sv": "Kod"
          },
          "placeholder": {
            "en": "F.160"
          }
        }
      ],
      "tokens": [
        {
          "name": "description",
          "type": "string",
          "title": {
            "en": "Description",
            "de": "Beschreibung",
            "nl": "Omschrijving",
            "fr": "Description",
            "sv": "Beskrivning"
          },
          "example": {
            "en": "Burner fault"
          }
        },
        {
          "name": "type",
          "type": "string",
          "title": {
            "en": "Type",
            "de": "Typ",
            "nl": "Type",
            "fr": "Type",
            "sv": "Typ"
          },
          "example": {
            "en": "device-error"
          }
        },
        {
          "name": "active",
          "type": "boolean",
          "title": {
            "en": "Active",
            "de": "Aktiv",
            "nl": "Actief",
            "fr": "Actif",
            "sv": "Aktiv"
          },
          "example": {
            "en": "true"
          }
        }
      ]
    }
  ]
}
