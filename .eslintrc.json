{
  "root": true,
  "extends": [
    "athom/homey-app"
  ],
  "rules": {
    "no-trailing-spaces": ["error", {"ignoreComments": true}]
  },
  "overrides": [
    {
      "files": ["test/**/*.js"],
      "env": {
        "jest": true
      },
      "rules": {
        "mocha/no-mocha-arrows": "off",
        "mocha/no-setup-in-describe": "off"
      }
    },
    {
      "files": ["**/__tests__/**/*.js", "__mocks__/*.js"],
      "rules": {
        "max-classes-per-file": "off"
      }
    }
  ]
}
