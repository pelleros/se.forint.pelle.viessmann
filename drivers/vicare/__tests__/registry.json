  "drivers": {
    "heating-circuit": {
      "class": "thermostat",
      "dataId": "<installationId>-<gatewaySerial>-<deviceId>-circuit-<part>",
      "capabilities": ["target_temperature", "measure_temperature", "thermostat_mode", "thermostat_mode.heating", "thermostat_mode.heatingProgram"],
      "store": ["installationId", "gatewaySerial", "deviceId", "roles", "heatingCircuitId", "features", "constraints", "commandMetadata", "operatingModes", "version"]
    },
    "hot-water": {
      "class": "thermostat",
      "dataId": "<installationId>-<gatewaySerial>-<deviceId>-hotwater",
      "capabilities": ["target_temperature", "measure_temperature", "thermostat_mode"],
